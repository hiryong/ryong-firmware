diff --git a/app/include/zmk/hid.h b/app/include/zmk/hid.h
index 962180e706d6952061e255551d89096faf5038c0..5197da25b60bc04a6d12e5e9e94f3bf8f830ef29 100644
--- a/app/include/zmk/hid.h
+++ b/app/include/zmk/hid.h
@@ -77,6 +77,14 @@
 #define ZMK_HID_REPORT_ID_CONSUMER 0x02
 #define ZMK_HID_REPORT_ID_MOUSE 0x03
 
+/* Ryong: ZMK Studio RPC over HID reports (app/src/studio/hid_rpc_transport.c). A vendor-defined
+ * collection, so hosts leave it alone and WebHID can open it while the keyboard stays connected.
+ * Each report: byte 0 = number of valid bytes (0..31), then up to 31 bytes of the Studio stream. */
+#define ZMK_HID_REPORT_ID_STUDIO 0x10
+#define ZMK_HID_STUDIO_REPORT_SIZE 32
+#define ZMK_HID_STUDIO_USAGE_PAGE_LO 0x5A
+#define ZMK_HID_STUDIO_USAGE_PAGE_HI 0xFF
+
 #ifndef HID_ITEM_TAG_PUSH
 #define HID_ITEM_TAG_PUSH 0xA
 #endif
@@ -253,6 +261,22 @@ static const uint8_t zmk_hid_report_desc[] = {
     HID_END_COLLECTION,
     HID_END_COLLECTION,
 #endif // IS_ENABLED(CONFIG_ZMK_POINTING)
+
+#if IS_ENABLED(CONFIG_ZMK_STUDIO_TRANSPORT_HID)
+    0x06, ZMK_HID_STUDIO_USAGE_PAGE_LO, ZMK_HID_STUDIO_USAGE_PAGE_HI, /* Usage Page (Vendor 0xFF5A) */
+    HID_USAGE(0x01),
+    HID_COLLECTION(HID_COLLECTION_APPLICATION),
+    HID_REPORT_ID(ZMK_HID_REPORT_ID_STUDIO),
+    HID_LOGICAL_MIN8(0x00),
+    HID_LOGICAL_MAX16(0xFF, 0x00),
+    HID_REPORT_SIZE(0x08),
+    HID_REPORT_COUNT(ZMK_HID_STUDIO_REPORT_SIZE),
+    HID_USAGE(0x02),
+    HID_INPUT(ZMK_HID_MAIN_VAL_DATA | ZMK_HID_MAIN_VAL_VAR | ZMK_HID_MAIN_VAL_ABS),
+    HID_USAGE(0x03),
+    HID_OUTPUT(ZMK_HID_MAIN_VAL_DATA | ZMK_HID_MAIN_VAL_VAR | ZMK_HID_MAIN_VAL_ABS),
+    HID_END_COLLECTION,
+#endif // IS_ENABLED(CONFIG_ZMK_STUDIO_TRANSPORT_HID)
 };
 
