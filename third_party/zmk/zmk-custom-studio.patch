+int zmk_hog_send_studio_report(struct bt_conn *conn, const uint8_t *data, size_t len) {
+    if (!conn) {
+        return -ENOTCONN;
+    }
+    if (bt_gatt_get_mtu(conn) < len + 3) {
+        LOG_WRN("Studio HID report needs ATT MTU %d, have %d", (int)(len + 3), bt_gatt_get_mtu(conn));
+        return -EMSGSIZE;
+    }
+    struct bt_gatt_notify_params params = {.attr = STUDIO_INPUT_ATTR, .data = data, .len = len};
