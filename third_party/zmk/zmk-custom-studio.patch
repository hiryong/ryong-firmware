+static int hid_rpc_transport_init(void) {
+    k_work_queue_start(&hid_rpc_q, hid_rpc_stack, K_THREAD_STACK_SIZEOF(hid_rpc_stack), 5, NULL);
+    k_thread_name_set(&hid_rpc_q.thread, "studio_hid");
+    return 0;
+}
+
+SYS_INIT(hid_rpc_transport_init, APPLICATION, CONFIG_APPLICATION_INIT_PRIORITY);
