diff --git a/app/src/studio/hid_rpc_transport.c b/app/src/studio/hid_rpc_transport.c
new file mode 100644
index 0000000000000000000000000000000000000000..36ea29ae8781f89691e4d4278c27484c9d30376a
--- /dev/null
+++ b/app/src/studio/hid_rpc_transport.c
@@ -0,0 +1,261 @@
+/*
+ * Copyright (c) 2026 The ZMK Contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * ZMK Studio RPC over a vendor-defined HID collection (Ryong).
+ *
+ * Browsers cannot reach a Bluetooth keyboard that is already connected to the computer over Web
+ * Bluetooth, but WebHID can open any connected HID device, USB or Bluetooth. The keyboard exposes
+ * one extra collection (usage page 0xFF5A) with a 32-byte input and output report:
+ *   byte 0 = number of valid bytes (0..31), bytes 1.. = the Studio byte stream (same framing as
+ *   the serial and GATT transports).
+ * Studio answers on the transport a request arrived on (zmk_rpc_note_rx), so this one
+ * answers on the same link: the BLE connection the request came from, or USB.
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/init.h>
+#include <zephyr/sys/ring_buffer.h>
+#include <zephyr/bluetooth/conn.h>
+#include <string.h>
+
+#include <zmk/hid.h>
+#include <zmk/studio/rpc.h>
+#include <zmk/studio/hid_transport.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_DECLARE(zmk_studio, CONFIG_ZMK_STUDIO_LOG_LEVEL);
+
+#define PAYLOAD (ZMK_HID_STUDIO_REPORT_SIZE - 1)
+
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+#define CONN_REF(c) ((c) ? bt_conn_ref(c) : NULL)
+#define CONN_UNREF(c) do { if (c) bt_conn_unref(c); } while (0)
+#else
+#define CONN_REF(c) ((c), (struct bt_conn *)NULL)
+#define CONN_UNREF(c) ((void)(c))
+#endif
+
+struct rx_item {
+    struct bt_conn *conn; /* referenced; NULL = USB */
+    uint8_t len;
+    uint8_t data[PAYLOAD];
+};
+
+K_MSGQ_DEFINE(hid_rx_q, sizeof(struct rx_item), 16, 4);
+
+static K_THREAD_STACK_DEFINE(hid_rpc_stack, 1536);
+static struct k_work_q hid_rpc_q;
+
+static K_MUTEX_DEFINE(peer_lock);
+static struct bt_conn *peer_conn; /* referenced; NULL with peer_usb = USB */
+static bool peer_usb;
+static bool handling_rx;
+
+static void tx_work_cb(struct k_work *work);
+static K_WORK_DEFINE(tx_work, tx_work_cb);
+
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+/* While Studio talks over BLE HID, ask the host to drop peripheral latency: with the keyboard's
+ * usual latency (CONFIG_BT_PERIPHERAL_PREF_LATENCY, often 30) every request waits for the
+ * keyboard's next listening slot, ~0.5 s, and loading a keymap takes hundreds of requests.
+ * Restored after a quiet period, so battery use is unchanged otherwise. (The GATT transport does
+ * the same when its notifications are enabled.) */
+#define FAST_IDLE K_SECONDS(20)
+static struct bt_conn *fast_conn;
+static void slow_work_cb(struct k_work *work);
+static K_WORK_DELAYABLE_DEFINE(slow_work, slow_work_cb);
+
+static void set_latency(struct bt_conn *conn, uint16_t latency) {
+    int err = bt_conn_le_param_update(conn, BT_LE_CONN_PARAM(CONFIG_BT_PERIPHERAL_PREF_MIN_INT, CONFIG_BT_PERIPHERAL_PREF_MAX_INT,
+                                                             latency, CONFIG_BT_PERIPHERAL_PREF_TIMEOUT));
+    if (err < 0 && err != -EALREADY) {
+        LOG_WRN("Studio HID: connection parameter update failed (%d)", err);
+    }
+}
+
+static K_MUTEX_DEFINE(fast_lock);
+
+static void slow_work_cb(struct k_work *work) {
+    ARG_UNUSED(work);
+    k_mutex_lock(&fast_lock, K_FOREVER);
+    if (fast_conn) {
+        set_latency(fast_conn, CONFIG_BT_PERIPHERAL_PREF_LATENCY);
+        bt_conn_unref(fast_conn);
+        fast_conn = NULL;
+    }
+    k_mutex_unlock(&fast_lock);
+}
+
+static void keep_fast(struct bt_conn *conn) {
+    k_mutex_lock(&fast_lock, K_FOREVER);
+    if (conn != fast_conn) {
+        if (fast_conn) {
+            bt_conn_unref(fast_conn);
+        }
+        fast_conn = bt_conn_ref(conn);
+        set_latency(conn, 0);
+    }
+    k_mutex_unlock(&fast_lock);
+    k_work_reschedule_for_queue(&hid_rpc_q, &slow_work, FAST_IDLE);
+}
+
+/* Never keep a reference to a closed connection: ZMK finds a profile's connection by address, and a
+ * still-referenced dead connection object can be returned instead of the live one after the host
+ * reconnects - keystrokes would then go nowhere until a restart. */
+static void studio_hid_disconnected(struct bt_conn *conn, uint8_t reason) {
+    ARG_UNUSED(reason);
+    k_mutex_lock(&fast_lock, K_FOREVER);
+    if (fast_conn == conn) {
+        bt_conn_unref(fast_conn);
+        fast_conn = NULL;
+    }
+    k_mutex_unlock(&fast_lock);
+    k_mutex_lock(&peer_lock, K_FOREVER);
+    if (peer_conn == conn) {
+        bt_conn_unref(peer_conn);
+        peer_conn = NULL;
+        peer_usb = false;
+    }
+    k_mutex_unlock(&peer_lock);
+}
+
+BT_CONN_CB_DEFINE(studio_hid_conn_cb) = {
+    .disconnected = studio_hid_disconnected,
+};
+#endif
+
+static int hid_start_rx(void) {
+    handling_rx = true;
+    return 0;
+}
+
+static int hid_stop_rx(void) {
+    handling_rx = false;
+    return 0;
+}
+
+static void hid_tx_notify(struct ring_buf *tx_buf, size_t added, bool msg_done, void *user_data) {
+    ARG_UNUSED(added);
+    ARG_UNUSED(user_data);
+    if (msg_done || ring_buf_size_get(tx_buf) >= PAYLOAD) {
+        k_work_submit_to_queue(&hid_rpc_q, &tx_work);
+    }
+}
+
+/* Never matches an endpoint, so endpoint changes never pick it; it is chosen by its own traffic. */
+ZMK_RPC_TRANSPORT(studio_hid_transport, ZMK_TRANSPORT_NONE, hid_start_rx, hid_stop_rx, NULL, hid_tx_notify);
+
+void zmk_studio_hid_rx(struct bt_conn *conn, const uint8_t *body, size_t len) {
+    if (len < 1) {
+        return;
+    }
+    struct rx_item item = {.len = MIN(body[0], MIN(len - 1, PAYLOAD))};
+    memcpy(item.data, body + 1, item.len);
+    item.conn = CONN_REF(conn);
+    if (k_msgq_put(&hid_rx_q, &item, K_NO_WAIT) < 0) {
+        LOG_WRN("Studio HID RX queue full, dropping a report");
+        CONN_UNREF(item.conn);
+        return;
+    }
+}
+
+static void set_peer(struct bt_conn *conn) {
+    k_mutex_lock(&peer_lock, K_FOREVER);
+    CONN_UNREF(peer_conn);
+    peer_conn = conn; /* takes over the reference */
+    peer_usb = conn == NULL;
+    k_mutex_unlock(&peer_lock);
+}
+
+/* Own thread, not a work item: taking over the transport may wait for a reply still being sent on
+ * another transport, whose draining runs on the system work queue or our TX queue. */
+static void rx_main(void) {
+    struct rx_item item;
+    while (k_msgq_get(&hid_rx_q, &item, K_FOREVER) == 0) {
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+        if (item.conn) {
+            keep_fast(item.conn);
+        }
+#endif
+        set_peer(item.conn);
+        zmk_rpc_note_rx(&studio_hid_transport);
+        struct ring_buf *rx = zmk_rpc_get_rx_buf();
+        uint32_t copied = 0;
+        while (copied < item.len) {
+            uint32_t n = ring_buf_put(rx, item.data + copied, item.len - copied);
+            if (n == 0) {
+                zmk_rpc_rx_notify();
+                k_sleep(K_MSEC(1));
+                continue;
+            }
+            copied += n;
+        }
+        zmk_rpc_rx_notify();
+    }
+}
+
+K_THREAD_DEFINE(studio_hid_rx, 1024, rx_main, NULL, NULL, NULL, 6, 0, 0);
+
+static int send_one(const uint8_t *report_body) {
+    struct bt_conn *conn = NULL;
+    bool usb;
+    k_mutex_lock(&peer_lock, K_FOREVER);
+    usb = peer_usb;
+    conn = CONN_REF(peer_conn);
+    k_mutex_unlock(&peer_lock);
+
+    int err;
+    if (usb) {
+#if IS_ENABLED(CONFIG_ZMK_USB)
+        uint8_t report[ZMK_HID_STUDIO_REPORT_SIZE + 1];
+        report[0] = ZMK_HID_REPORT_ID_STUDIO;
+        memcpy(report + 1, report_body, ZMK_HID_STUDIO_REPORT_SIZE);
+        err = zmk_usb_hid_send_studio_report(report, sizeof(report));
+#else
+        err = -ENOTSUP;
+#endif
+    } else {
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+        err = zmk_hog_send_studio_report(conn, report_body, ZMK_HID_STUDIO_REPORT_SIZE);
+#else
+        err = -ENOTSUP;
+#endif
+    }
+    CONN_UNREF(conn);
+    return err;
+}
+
+static void tx_work_cb(struct k_work *work) {
+    ARG_UNUSED(work);
+    struct ring_buf *tx = zmk_rpc_get_tx_buf();
+    uint8_t body[ZMK_HID_STUDIO_REPORT_SIZE];
+    while (ring_buf_size_get(tx) > 0) {
+        memset(body, 0, sizeof(body));
+        body[0] = ring_buf_get(tx, body + 1, PAYLOAD);
+        int err = -EAGAIN;
+        for (int tries = 0; tries < 200; tries++) {
+            err = send_one(body);
+            if (err != -ENOMEM && err != -EAGAIN && err != -EBUSY) {
+                break;
+            }
+            k_sleep(K_MSEC(2)); /* BLE TX buffers busy: wait for the controller */
+        }
+        if (err < 0) {
+            LOG_WRN("Studio HID report send failed (%d), dropping the rest", err);
+            ring_buf_reset(tx);
+            return;
+        }
+    }
+}
